+    // Is this id still bound to a host? Guards against a stale alarm firing for a
+    // widget the user has removed.
+    private boolean isWidgetActive(Context context, int widgetId) {
+        try {
+            int[] live = AppWidgetManager.getInstance(context)
+                .getAppWidgetIds(new ComponentName(context, getClass()));
+            for (int id : live) {
+                if (id == widgetId) return true;
+            }
+        } catch (Exception e) {
+            // If we can't tell, let it through: a spurious render is cheaper than a
+            // widget that stops updating.
+            return true;
+        }
+        return false;
+    }
