+    // Schedule the next unattended re-render, at the streak day's rollover.
+    //
+    // updatePeriodMillis is a 30-minute floor that Doze defers indefinitely, so a
+    // widget on an idle phone can sit on yesterday's state for hours - and once a
+    // Chronometer is running it ticks visibly NEGATIVE past its target, which
+    // looks broken rather than merely stale. iOS gets this free from a WidgetKit
+    // timeline; Android has no equivalent, so we set the alarm ourselves.
+    //
+    // The render tells us how long until the rollover (clickActionData.rolloverMs).
+    // setAndAllowWhileIdle rather than setExact*: exact alarms need
+    // SCHEDULE_EXACT_ALARM, denied by default on targetSdk 33+. Inexact fires
+    // immediately while the device is awake and within a few minutes in deep Doze
+    // - and a widget nobody can see does not need to be right yet.
+    //
+    // The alarm broadcasts a custom <pkg>.WIDGET_* action, which RNWidgetProvider
+    // turns back into an ordinary WIDGET_UPDATE. Every render therefore arms the
+    // next one, so the chain sustains itself with the app closed.
+    private void scheduleRolloverUpdate(int widgetId, ReadableMap rootConfig) {
+        try {
+            long rolloverMs = 0;
+            if (rootConfig != null && rootConfig.hasKey("props")) {
+                ReadableMap props = rootConfig.getMap("props");
+                if (props != null && props.hasKey("clickActionData")) {
+                    ReadableMap data = props.getMap("clickActionData");
+                    if (data != null && data.hasKey("rolloverMs")) {
+                        rolloverMs = (long) data.getDouble("rolloverMs");
+                    }
+                }
+            }
+            if (rolloverMs <= 0) return;
+
+            String pkg = appContext.getPackageName();
+            Intent intent = new Intent(appContext, Class.forName(pkg + ".widget." + widgetName));
+            intent.setAction(pkg + ".WIDGET_SCHEDULED_UPDATE");
+            intent.putExtra("widgetId", widgetId);
+            // RNWidgetProvider.onReceive switches on clickAction - never leave it null.
+            intent.putExtra("clickAction", "SCHEDULED_UPDATE");
+
+            int flags = PendingIntent.FLAG_UPDATE_CURRENT;
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
+                flags |= PendingIntent.FLAG_IMMUTABLE;
+            }
+            // widgetId as the request code: one pending alarm per widget instance,
+            // each re-render replacing its own rather than stacking.
+            PendingIntent pending =
+                PendingIntent.getBroadcast(appContext, widgetId, intent, flags);
+
+            AlarmManager alarms =
+                (AlarmManager) appContext.getSystemService(Context.ALARM_SERVICE);
+            if (alarms == null) return;
+            long at = System.currentTimeMillis() + rolloverMs;
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
+                alarms.setAndAllowWhileIdle(AlarmManager.RTC_WAKEUP, at, pending);
+            } else {
+                alarms.set(AlarmManager.RTC_WAKEUP, at, pending);
+            }
+        } catch (Exception e) {
+            // Never fail a render over a missed alarm: the updatePeriodMillis tick
+            // stays as the backstop, exactly as before this patch.
+            e.printStackTrace();
+        }
+    }
+
+    // Live countdown overlay. The root widget passes { showCountdown, countdownMs }
+    // via clickActionData (a supported passthrough). When shown, we drive a native
+    // Chronometer that ticks down to the target with no app process — the one thing
+    // a flattened-bitmap widget can't do on its own. countdownMs is the remaining
+    // time at render; the Chronometer keeps ticking accurately between re-renders.
+    private void applyCountdown(RemoteViews remoteWidgetView, ReadableMap rootConfig) {
+        boolean show = false;
+        long countdownMs = 0;
+        if (rootConfig != null && rootConfig.hasKey("props")) {
+            ReadableMap props = rootConfig.getMap("props");
+            if (props != null && props.hasKey("clickActionData")) {
+                ReadableMap data = props.getMap("clickActionData");
+                if (data != null && data.hasKey("showCountdown") && data.getBoolean("showCountdown")) {
+                    show = true;
+                    if (data.hasKey("countdownMs")) {
+                        countdownMs = (long) data.getDouble("countdownMs");
+                    }
+                }
+            }
+        }
+
+        if (show && Build.VERSION.SDK_INT >= Build.VERSION_CODES.N) {
+            long base = android.os.SystemClock.elapsedRealtime() + Math.max(0, countdownMs);
+            remoteWidgetView.setChronometer(R.id.rn_widget_chronometer, base, "%s", true);
+            remoteWidgetView.setChronometerCountDown(R.id.rn_widget_chronometer, true);
+            // Urgency colour by time remaining (set per render, so it steps as the
+            // widget refreshes — on app-open + every ~30 min): white >=12h, amber
+            // under 12h, red under 4h.
+            int countdownColor = 0xFFFFFFFF;
+            if (countdownMs < 4L * 60 * 60 * 1000) {
+                countdownColor = 0xFFFF5C5C;
+            } else if (countdownMs < 12L * 60 * 60 * 1000) {
+                countdownColor = 0xFFFFC83C;
+            }
+            remoteWidgetView.setTextColor(R.id.rn_widget_chronometer, countdownColor);
+            remoteWidgetView.setViewVisibility(R.id.rn_widget_chronometer, View.VISIBLE);
+        } else {
+            remoteWidgetView.setViewVisibility(R.id.rn_widget_chronometer, View.GONE);
+        }
+    }
