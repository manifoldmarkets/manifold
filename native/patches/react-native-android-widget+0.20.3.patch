+    // Schedule the next unattended re-render, at the streak day's rollover.
+    //
+    // updatePeriodMillis is a 30-minute floor that Doze defers indefinitely, so a
+    // widget on an idle phone can sit on yesterday's state for hours - and once a
+    // Chronometer is running it ticks visibly NEGATIVE past its target, which
+    // looks broken rather than merely stale. iOS gets this free from a WidgetKit
+    // timeline; Android has no equivalent, so we set the alarm ourselves.
+    //
+    // The render tells us how long until the rollover (clickActionData.rolloverMs).
+    // An inexact alarm, not setExact*: exact alarms need SCHEDULE_EXACT_ALARM,
+    // denied by default on targetSdk 33+ and a poor thing to demand for a widget.
+    // This is therefore BEST EFFORT - Android may deliver an inexact alarm up to
+    // an hour late, and Doze or battery saver can stretch that further. It is a
+    // large improvement on updatePeriodMillis alone, which stays as the backstop,
+    // but it is not a guarantee: a briefly negative countdown remains possible.
+    //
+    // RTC, not RTC_WAKEUP: the widget only has to be right once someone can see
+    // it, so there is no reason to wake a sleeping phone - which would cold-start
+    // WorkManager and React Native at midnight for every widget instance. A
+    // non-wakeup alarm is delivered at the device's next wakeup instead.
+    //
+    // And plain set(), not setAndAllowWhileIdle(): the latter no longer wakes the
+    // CPU once RTC replaces RTC_WAKEUP, but it still buys a Doze exemption so the
+    // work can run during an unrelated maintenance window. Nothing here needs to
+    // run while the device is idle, so set() matches the intent - deliver once
+    // Doze ends. Neither API means "screen visible"; there is no such alarm.
+    //
+    // The alarm broadcasts a custom <pkg>.WIDGET_* action, which RNWidgetProvider
+    // dispatches as WIDGET_ROLLOVER - deliberately NOT an ordinary WIDGET_UPDATE,
+    // which would re-fetch and could cache a row the backend's midnight job has
+    // not reached yet. Every render arms the next alarm, so the chain sustains
+    // itself with the app closed.
+    private void scheduleRolloverUpdate(int widgetId, ReadableMap rootConfig) {
+        try {
+            long rolloverMs = 0;
+            if (rootConfig != null && rootConfig.hasKey("props")) {
+                ReadableMap props = rootConfig.getMap("props");
+                if (props != null && props.hasKey("clickActionData")) {
+                    ReadableMap data = props.getMap("clickActionData");
+                    if (data != null && data.hasKey("rolloverMs")) {
+                        rolloverMs = (long) data.getDouble("rolloverMs");
+                    }
+                }
+            }
+            if (rolloverMs <= 0) return;
+
+            String pkg = appContext.getPackageName();
+            Intent intent = new Intent(appContext, Class.forName(pkg + ".widget." + widgetName));
+            intent.setAction(pkg + ".WIDGET_SCHEDULED_UPDATE");
+            intent.putExtra("widgetId", widgetId);
+            // RNWidgetProvider.onReceive switches on clickAction - never leave it null.
+            intent.putExtra("clickAction", "SCHEDULED_UPDATE");
+
+            int flags = PendingIntent.FLAG_UPDATE_CURRENT;
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
+                flags |= PendingIntent.FLAG_IMMUTABLE;
+            }
+            // widgetId as the request code: one pending alarm per widget instance,
+            // each re-render replacing its own rather than stacking.
+            PendingIntent pending =
+                PendingIntent.getBroadcast(appContext, widgetId, intent, flags);
+
+            AlarmManager alarms =
+                (AlarmManager) appContext.getSystemService(Context.ALARM_SERVICE);
+            if (alarms == null) return;
+            long at = System.currentTimeMillis() + rolloverMs;
+            alarms.set(AlarmManager.RTC, at, pending);
