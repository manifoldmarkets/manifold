+    // Drop the pending rollover alarm for a removed widget. Must construct the
+    // PendingIntent identically to RNWidget.scheduleRolloverUpdate (same action,
+    // same request code) or it won't match the one to cancel.
+    private void cancelRolloverUpdate(Context context, int widgetId) {
+        try {
+            Intent intent = new Intent(context, getClass());
+            intent.setAction(context.getPackageName() + ".WIDGET_SCHEDULED_UPDATE");
+            int flags = PendingIntent.FLAG_NO_CREATE;
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
+                flags |= PendingIntent.FLAG_IMMUTABLE;
+            }
+            PendingIntent pending =
+                PendingIntent.getBroadcast(context, widgetId, intent, flags);
+            if (pending == null) return;
+            AlarmManager alarms =
+                (AlarmManager) context.getSystemService(Context.ALARM_SERVICE);
+            if (alarms != null) alarms.cancel(pending);
+            pending.cancel();
+        } catch (Exception e) {
+            e.printStackTrace();
+        }
+    }
