# --- Manifold ---
# Dev by default. Change to https://api.manifold.markets when you go live.
MANIFOLD_API_URL=https://api.dev.manifold.markets
# API key for the account the markets are created under
# (for dev: your dev.manifold.markets account > profile > edit > API key)
MANIFOLD_API_KEY=

# Mana the creator puts in to start each market (also its cost): 100, 1000, 10000 or 100000
LIQUIDITY_TIER=100

# --- Anthropic (drafts the market) --- console.anthropic.com
ANTHROPIC_API_KEY=

# --- X (only needed for the bot itself, not for `npm run try`) ---
# App keys (console.x.com > your app > Keys and tokens)
X_API_KEY=
X_API_SECRET=
# Access token + secret generated while logged in as the BOT account, Read and Write permission
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# The one account allowed to trigger the bot (handle, no @). Your alt while testing.
ALLOWED_USERNAME=

# --- Options ---
# true = log what would happen without creating markets or posting replies
DRY_RUN=false
POLL_SECONDS=90
