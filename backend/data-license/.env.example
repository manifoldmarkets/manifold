# ---------------------------------------------------------------------------
# data-license export job — runtime configuration
#
# The SAME artifact runs locally and as a Cloud Run Job; only these env vars
# differ. NOTHING that identifies a licensee (name, slug, or even how many
# licensees exist) lives in code or in this committed file. All of that is
# supplied per-invocation, from your shell locally or from the job definition
# + Secret Manager in the cloud. This file is a placeholder template — copy it
# to a gitignored .env and fill it in, or export the vars into your shell.
#
# There is no dotenv loader in this repo; export these (`set -a; . ./.env`) or
# pass them via the container/job definition.
# ---------------------------------------------------------------------------

# Opaque delivery identifier. Used only as the R2 prefix and in the manifest.
# Use whatever the job definition passes; never a real client name in code.
CLIENT_ID=example-client

# Snapshot / delivery date (YYYY-MM-DD). Defaults to today if unset.
DELIVERY_DATE=

# --- Pseudonymization salt -------------------------------------------------
# EXACTLY ONE of these. The salt must be byte-identical across every monthly
# run for a given client, forever, or cross-delivery track records stop joining.
#
# THE SALT IS AN HMAC KEY, NOT A NONCE. Manifold user ids are public via the
# API, so anyone who learns (or dictionary-guesses) the salt can HMAC every
# public id and reverse the whole pseudonym map. For any real delivery it must
# be high-entropy random (e.g. `openssl rand -hex 32`), generated once per
# client, and kept secret forever.
#   Local testing:   set EXPORT_SALT to any throwaway value.
#   Cloud:           leave EXPORT_SALT empty and point at a Secret Manager
#                    version. The resource name is runtime config, so the
#                    client is never named in code.
EXPORT_SALT=
SALT_SECRET_RESOURCE=
# e.g. projects/123456789/secrets/<opaque-secret-name>/versions/latest

PSEUDONYM_PREFIX=User_
PSEUDONYM_HEX_LEN=20

# --- Validation: forbidden strings ----------------------------------------
# Comma-separated literal strings that must NOT appear anywhere in the output
# (the licensee's real name, aliases, etc.). Supplied at runtime so the name
# never enters the repo. Prefer the secret form in the cloud.
FORBIDDEN_STRINGS=
FORBIDDEN_STRINGS_SECRET_RESOURCE=

# --- Output ----------------------------------------------------------------
LOCAL_OUT_DIR=./out
# Which segments to include: A (reasoning-corpus), B (question-corpus),
# C (probability-series). Comma-separated; default all.
SEGMENTS=A,B,C

# Test knobs
SUBSET_LIMIT=          # cap contracts pulled, for fast local dry runs
# DRY_RUN=true does NOT skip uploads: if R2_* is configured it still uploads,
# just under a _dryrun/<date>/ prefix — in the client's bucket, visible to a
# customer read token. For a truly local run leave R2_* unset; better, point
# dry runs at a separate scratch bucket.
DRY_RUN=true

# --- R2 (Cloudflare, S3-compatible) ---------------------------------------
# ONE BUCKET PER LICENSEE — the bucket is the access boundary (R2 tokens scope
# to buckets, not prefixes). The customer gets a read-only, bucket-scoped token.
# So R2_BUCKET is per-client runtime config; the key path carries no client id,
# just <date>/ (or _dryrun/<date>/). Provide the per-client bucket here.
R2_BUCKET=
R2_ENDPOINT=           # https://<accountid>.r2.cloudflarestorage.com  (account origin; bucket path is stripped)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Source database -------------------------------------------------------
# Reuses the shared connection env. Point at the ephemeral PITR clone for real
# runs (load isolation) or dev/prod for testing. Reads happen inside ONE
# REPEATABLE READ snapshot regardless of target.
SUPABASE_HOST=
SUPABASE_PORT=5432
SUPABASE_PASSWORD=
SUPABASE_INSTANCE_ID=
